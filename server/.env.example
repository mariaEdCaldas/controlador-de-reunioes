# Configuração de envio de e-mail dos lembretes.
#
# COMO USAR:
#   1. Copie este arquivo para  server/.env   (sem ".example")
#   2. Preencha SMTP_USER e SMTP_PASS abaixo
#   3. Reinicie o sistema (npm run dev)
#
# O arquivo .env NÃO é versionado no Git — a senha fica só na sua máquina.

# Seu e-mail do Gmail (o que envia os lembretes).
SMTP_USER=mariaeduardacaldas1@gmail.com

# SENHA DE APP do Gmail (16 letras), NÃO a senha normal da conta.
# Como gerar:
#   1. Ative a verificação em 2 etapas: https://myaccount.google.com/security
#   2. Crie uma senha de app:            https://myaccount.google.com/apppasswords
#   3. Cole aqui as 16 letras (pode ser com ou sem espaços).
SMTP_PASS=

# --- Opcionais (só mude se souber o que está fazendo) ---
# SMTP_FROM=mariaeduardacaldas1@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# HORA_DISPARO=8

# =====================================================================
# PUBLICAÇÃO (produção) — só preencher quando for hospedar (ver DEPLOY.md)
# Localmente NÃO precisa: sem estas, o sistema usa o arquivo SQLite local.
# =====================================================================

# Banco na nuvem (Turso). Pegue no painel do Turso ao criar o banco.
# DATABASE_URL=libsql://seu-banco-xxxx.turso.io
# DATABASE_TOKEN=coloque-o-token-do-turso-aqui

# Segredo para assinar o login (invente uma frase longa e aleatória).
# JWT_SEGREDO=troque-por-uma-frase-bem-grande-e-secreta

# Endereço da tela publicada (Vercel), para liberar o CORS.
# Pode ter vários separados por vírgula.
# CORS_ORIGIN=https://seu-app.vercel.app
